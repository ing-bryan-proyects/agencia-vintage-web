---
import LayoutA from "@/layouts/LayoutA.astro";
import Icono from "@/components/Icono.astro";
import Abanico from "@/components/Abanico.astro";
import LogosClientes from "@/components/LogosClientes.astro";
import CtaA from "@/components/modelo-a/CtaA.astro";
import Compromiso from "@/components/Compromiso.astro";
import Aliados from "@/components/Aliados.astro";
import { whatsappUrl } from "@/data/contacto";
import { pilares, pasos, beneficiosCumplimiento, propuesta } from "@/data/agencia";
import { categorias } from "@/data/seguros";
---
<LayoutA title="Inicio" active="inicio">
  <!-- PORTADA -->
  <section class="relative overflow-hidden bg-ink">
    <Abanico class="fan-pattern -bottom-10 right-[-120px] hidden w-[760px] opacity-15 lg:block" color="#d9be86" />
    <div class="mx-auto grid max-w-7xl items-center gap-12 px-6 py-16 lg:grid-cols-2 lg:px-10 lg:py-24">
      <div class="flex flex-col gap-7">
        <span class="flex items-center gap-3 text-[13px] font-semibold uppercase tracking-[0.16em] text-gold">
          <span class="h-px w-10 bg-gold"></span>Asesoría y colocación de seguros
        </span>
        <h1 class="font-display text-4xl font-bold leading-[1.05] text-white sm:text-5xl lg:text-6xl">
          Comprometidos con tu tranquilidad y <span class="text-gold">tu seguridad.</span>
        </h1>
        <p class="max-w-xl text-lg leading-relaxed text-cream/75">
          Gestionamos y asesoramos para que disfrutes de total tranquilidad, sabiendo que tú, tu familia y tu negocio están protegidos por nuestra amplia cobertura de seguros.
        </p>

        <!-- Cotizador rápido -->
        <form class="flex max-w-xl flex-col gap-2 rounded-3xl bg-cream-2 p-2 sm:flex-row sm:items-center" aria-label="Cotizador rápido">
          <label class="flex flex-1 flex-col px-4 pt-1 text-[11.5px] font-semibold uppercase tracking-[0.08em] text-gold-ink">
            ¿Qué quieres asegurar?
            <select name="tipo" class="h-8 border-0 bg-transparent text-[15px] font-medium normal-case tracking-normal text-ink focus:outline-none">
              <option>Mi vehículo</option>
              <option>Mi empresa</option>
              <option>Mi vida y mi familia</option>
              <option>Mi carga o mercancía</option>
              <option>Un contrato (cumplimiento)</option>
            </select>
          </label>
          <label class="flex flex-col px-4 pt-1 text-[11.5px] font-semibold uppercase tracking-[0.08em] text-gold-ink sm:border-l sm:border-black/10">
            Tu celular
            <input type="tel" name="celular" placeholder="300 000 0000" class="h-8 border-0 bg-transparent text-[15px] normal-case tracking-normal text-ink placeholder:text-slate/50 focus:outline-none" />
          </label>
          <button type="submit" class="h-14 rounded-full bg-ink px-8 font-semibold text-gold transition-colors hover:bg-ink-soft">Cotizar</button>
        </form>
        <a href={whatsappUrl} class="text-[15px] font-medium text-gold hover:text-gold-soft">o escríbenos por WhatsApp →</a>

        <div class="flex flex-wrap gap-x-7 gap-y-2 pt-1 text-sm text-cream/60">
          <span class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-gold"></span>Acompañamiento en reclamaciones</span>
          <span class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-gold"></span>Financiación del 100% de la póliza</span>
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-md">
        <div class="rounded-t-[230px] rounded-b-2xl border-2 border-gold p-3">
          <div class="aspect-[3/4] overflow-hidden rounded-t-[220px] rounded-b-xl bg-navy">
            <img src="/images/fotos/asesor-oficina.jpg" alt="Asesor de Agencia Vintage" class="h-full w-full object-cover" />
          </div>
        </div>
        <div class="absolute -bottom-6 left-0 flex w-64 items-center gap-3 rounded-2xl bg-cream-2 p-5 shadow-brand">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-ink text-gold"><Icono name="escudo" class="h-5 w-5" /></span>
          <span class="flex flex-col gap-0.5">
            <span class="text-sm font-bold text-ink">Agentes certificados</span>
            <span class="text-[12.5px] leading-snug text-mute">por Fasecolda, Federación de Aseguradores Colombianos</span>
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- PILARES -->
  <section class="border-b border-[#e6dcc8] bg-cream-2 px-6 py-16 lg:px-10">
    <div class="mx-auto grid max-w-7xl gap-10 md:grid-cols-3">
      {pilares.map((p) => (
        <div class="flex items-start gap-5">
          <span class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-ink text-gold"><Icono name={p.icono} class="h-7 w-7" /></span>
          <div class="flex flex-col gap-2">
            <h2 class="font-display text-2xl text-ink">{p.titulo}</h2>
            <p class="text-[15px] leading-relaxed text-mute">{p.texto}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- SERVICIOS -->
  <section class="bg-cream px-6 py-24 lg:px-10">
    <div class="mx-auto flex max-w-7xl flex-col gap-12">
      <div class="flex flex-col items-end justify-between gap-8 md:flex-row">
        <div class="flex flex-col gap-4">
          <span class="flex items-center gap-3 text-[13px] font-semibold uppercase tracking-[0.16em] text-gold-ink">
            <span class="h-px w-10 bg-gold-ink"></span>Nuestros servicios
          </span>
          <h2 class="font-display text-4xl font-bold leading-tight text-ink sm:text-5xl">
            Una cobertura para cada<br class="hidden sm:block" /> etapa y cada negocio
          </h2>
        </div>
        <a href="/a/servicios" class="inline-flex h-13 shrink-0 items-center gap-2.5 rounded-full border border-ink px-6 py-3 font-semibold text-ink transition-colors hover:bg-ink hover:text-white">
          Ver todos los servicios <Icono name="flecha" class="h-4 w-4" />
        </a>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
        {categorias.map((c) => (
          <a href="/a/servicios" class="flex flex-col gap-3.5 rounded-3xl border border-[#e6dcc8] bg-cream-2 p-7 transition-shadow hover:shadow-brand">
            <span class="flex h-14 w-14 items-center justify-center rounded-full bg-ink text-gold"><Icono name={c.icono} class="h-6 w-6" /></span>
            <h3 class="mt-1 font-display text-2xl font-bold leading-tight text-ink">{c.nombre}</h3>
            <p class="text-[14.5px] leading-snug text-mute">{c.intro}</p>
            <span class="mt-auto pt-2 text-sm font-semibold text-gold-ink">Ver pólizas →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CÓMO TRABAJAMOS -->
  <section class="bg-cream-2 px-6 py-24 lg:px-10">
    <div class="mx-auto flex max-w-7xl flex-col gap-14">
      <div class="flex flex-col items-center gap-4 text-center">
        <span class="flex items-center gap-3 text-[13px] font-semibold uppercase tracking-[0.16em] text-gold-ink">
          <span class="h-px w-10 bg-gold-ink"></span>Cómo trabajamos<span class="h-px w-10 bg-gold-ink"></span>
        </span>
        <h2 class="font-display text-4xl font-bold text-ink sm:text-5xl">Te acompañamos en cada paso</h2>
      </div>
      <ol class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {pasos.map((p, i) => (
          <li class="flex flex-col items-center gap-3.5 text-center">
            <span class="flex h-18 w-18 items-center justify-center rounded-full border border-gold bg-ink font-display text-2xl font-bold text-gold">{i + 1}</span>
            <h3 class="mt-1 font-display text-xl font-bold text-ink">{p.titulo}</h3>
            <p class="text-[15px] leading-relaxed text-mute">{p.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- PROPUESTA DE VALOR -->
  <section class="relative overflow-hidden bg-navy px-6 py-24 lg:px-10">
    <Abanico class="fan-pattern -top-16 left-[-140px] w-[520px] rotate-180 opacity-10" color="#d9be86" />
    <div class="mx-auto grid max-w-7xl items-center gap-16 lg:grid-cols-2">
      <div class="flex flex-col gap-6">
        <span class="flex items-center gap-3 text-[13px] font-semibold uppercase tracking-[0.16em] text-gold">
          <span class="h-px w-10 bg-gold"></span>Propuesta de valor
        </span>
        <h2 class="font-display text-4xl font-bold leading-tight text-white sm:text-5xl">{propuesta.titulo}</h2>
        <p class="text-lg leading-relaxed text-[#c3cedc]">{propuesta.texto}</p>
        <a href="/a/quienes-somos" class="inline-flex h-13 w-fit items-center gap-2.5 rounded-full border border-gold px-6 py-3 font-semibold text-gold transition-colors hover:bg-gold hover:text-ink">
          Conoce quiénes somos <Icono name="flecha" class="h-4 w-4" />
        </a>
      </div>
      <div class="flex flex-col gap-6 rounded-3xl bg-cream-2 p-8 sm:p-10">
        <div class="flex flex-col gap-1.5">
          <span class="text-[13px] font-semibold uppercase tracking-[0.14em] text-gold-ink">Beneficios</span>
          <h3 class="font-display text-3xl font-bold text-ink">Pólizas de cumplimiento</h3>
        </div>
        <ul class="grid gap-3.5 sm:grid-cols-2">
          {beneficiosCumplimiento.map((b) => (
            <li class="flex gap-2.5 text-[15px] leading-snug text-carbon">
              <Icono name="check" class="mt-0.5 h-5 w-5 shrink-0 text-gold-ink" />{b}
            </li>
          ))}
        </ul>
        <div class="flex items-center gap-4 rounded-2xl bg-ink p-5 text-white">
          <span class="font-display text-4xl font-bold text-gold">100%</span>
          <span class="text-[15px] leading-snug text-cream">de tu póliza financiado con nuestros aliados financieros</span>
        </div>
      </div>
    </div>
  </section>

  <!-- CLIENTES -->
  <section class="bg-cream px-6 py-24 lg:px-10">
    <div class="mx-auto flex max-w-7xl flex-col gap-11">
      <div class="flex flex-col items-end justify-between gap-8 md:flex-row">
        <div class="flex flex-col gap-4">
          <span class="flex items-center gap-3 text-[13px] font-semibold uppercase tracking-[0.16em] text-gold-ink">
            <span class="h-px w-10 bg-gold-ink"></span>Nuestros clientes
          </span>
          <h2 class="font-display text-4xl font-bold text-ink sm:text-5xl">Empresas que confían en nosotros</h2>
        </div>
        <p class="max-w-md text-base leading-relaxed text-mute">
          Transportadoras, cooperativas, firmas de abogados y comercios protegen su patrimonio con Vintage.
        </p>
      </div>
      <LogosClientes theme="a" />
    </div>
  </section>

  <!-- ALIADOS -->
  <section class="bg-cream-2 px-6 py-24 lg:px-10">
    <div class="mx-auto flex max-w-7xl flex-col gap-11">
      <div class="flex flex-col items-center gap-4 text-center">
        <span class="flex items-center gap-3 text-[13px] font-semibold uppercase tracking-[0.16em] text-gold-ink">
          <span class="h-px w-10 bg-gold-ink"></span>Aseguradoras y aliados
        </span>
        <h2 class="font-display text-4xl font-bold text-ink sm:text-5xl">Respaldados por los mejores</h2>
      </div>
      <Aliados theme="a" />
    </div>
  </section>

  <Compromiso theme="a" />

  <CtaA />
</LayoutA>
