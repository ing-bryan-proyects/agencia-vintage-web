---
import LayoutB from "@/layouts/LayoutB.astro";
import Icono from "@/components/Icono.astro";
import Abanico from "@/components/Abanico.astro";
import { contacto, telUrl, correoUrl, whatsappUrl, mapaEmbedUrl, mapaLinkUrl } from "@/data/contacto";

const canales = [
  { titulo: "Llámanos", texto: contacto.telefonos.join("\n"), icono: "telefono", href: telUrl, dark: false },
  { titulo: "WhatsApp", texto: "Escríbenos y un asesor te responde", icono: "whatsapp", href: whatsappUrl, dark: false },
  { titulo: "Correo", texto: contacto.correo, icono: "correo", href: correoUrl, dark: false },
  { titulo: "Reporta un siniestro", texto: "Te acompañamos en la reclamación", icono: "escudo", href: "#formulario", dark: true },
];
---
<LayoutB title="Contacto" active="contacto">
  <!-- PORTADA -->
  <section class="relative overflow-hidden bg-navy px-6 pb-32 pt-16 lg:px-10">
    <Abanico class="fan-pattern -bottom-16 right-[-40px] hidden w-[560px] opacity-35 md:block" color="#c9a45c" />
    <div class="relative mx-auto flex max-w-7xl flex-col gap-4">
      <nav aria-label="Ruta" class="flex gap-2 text-[13.5px] text-[#a9b6ca]"><a href="/b" class="hover:text-white">Inicio</a><span>/</span><span class="font-bold text-white">Contacto</span></nav>
      <h1 class="text-4xl font-extrabold leading-[1.06] tracking-tight text-white sm:text-5xl">Estamos para ayudarte</h1>
      <p class="max-w-2xl text-lg leading-relaxed text-[#c8d3e3]">Elige el canal que prefieras: cotizaciones, dudas sobre tu póliza o acompañamiento en un siniestro.</p>
    </div>
  </section>

  <!-- CANALES -->
  <section class="bg-white px-6 lg:px-10">
    <div class="mx-auto -mt-18 grid max-w-7xl gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {canales.map((c) => (
        <a href={c.href} class:list={["flex flex-col gap-2.5 rounded-2xl p-6 shadow-brand transition-transform hover:-translate-y-1", c.dark ? "bg-gold-2 text-navy" : "bg-white text-navy"]}>
          <span class:list={["flex h-12 w-12 items-center justify-center rounded-xl", c.dark ? "bg-navy text-gold-soft" : "bg-sand text-gold-ink"]}><Icono name={c.icono} class="h-5 w-5" /></span>
          <span class="text-[17px] font-extrabold">{c.titulo}</span>
          <span class:list={["whitespace-pre-line text-[14.5px] leading-relaxed", c.dark ? "text-[#2a3a52]" : "text-slate"]}>{c.texto}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- FORMULARIO Y MAPA -->
  <section id="formulario" class="scroll-mt-24 bg-white px-6 py-24 lg:px-10">
    <div class="mx-auto grid max-w-7xl gap-8 lg:grid-cols-[7fr_5fr]">
      <form class="grid gap-5 rounded-3xl border border-[#e3ded3] p-8 sm:grid-cols-2 sm:p-11" method="post" action="#" data-mailto="agenciavintagedeseguros@gmail.com" data-asunto="Nuevo mensaje desde el sitio web">
        <div class="flex flex-col gap-1.5 sm:col-span-2">
          <h2 class="text-3xl font-extrabold tracking-tight text-navy">Escríbenos</h2>
          <p class="text-[15px] text-slate">Completa el formulario y te contactamos.</p>
        </div>
        <label class="flex flex-col gap-2 text-[13.5px] font-bold text-[#3a4252] sm:col-span-2">Motivo
          <select name="motivo" class="h-13 rounded-xl border border-[#d9d3c5] bg-white px-3.5 text-[15px] text-carbon">
            <option>Quiero cotizar un seguro</option><option>Reportar un siniestro</option><option>Financiar mi póliza</option><option>Otra consulta</option>
          </select>
        </label>
        <label class="flex flex-col gap-2 text-[13.5px] font-bold text-[#3a4252]">Nombre completo
          <input type="text" name="nombre" required placeholder="Tu nombre" class="h-13 rounded-xl border border-[#d9d3c5] px-4 text-[15px] text-carbon" />
        </label>
        <label class="flex flex-col gap-2 text-[13.5px] font-bold text-[#3a4252]">Celular
          <input type="tel" name="celular" placeholder="300 000 0000" class="h-13 rounded-xl border border-[#d9d3c5] px-4 text-[15px] text-carbon" />
        </label>
        <label class="flex flex-col gap-2 text-[13.5px] font-bold text-[#3a4252]">Correo electrónico
          <input type="email" name="correo" placeholder="tucorreo@ejemplo.com" class="h-13 rounded-xl border border-[#d9d3c5] px-4 text-[15px] text-carbon" />
        </label>
        <label class="flex flex-col gap-2 text-[13.5px] font-bold text-[#3a4252]">Ciudad
          <input type="text" name="ciudad" placeholder="Tu ciudad" class="h-13 rounded-xl border border-[#d9d3c5] px-4 text-[15px] text-carbon" />
        </label>
        <label class="flex flex-col gap-2 text-[13.5px] font-bold text-[#3a4252] sm:col-span-2">Mensaje
          <textarea name="mensaje" rows="4" placeholder="Cuéntanos brevemente tu caso" class="resize-none rounded-xl border border-[#d9d3c5] p-4 text-[15px] leading-relaxed text-carbon"></textarea>
        </label>
        <label class="flex items-start gap-3 text-[13.5px] leading-relaxed text-slate sm:col-span-2">
          <input type="checkbox" name="datos" required class="mt-0.5 h-5 w-5 shrink-0 accent-navy" />
          Autorizo el tratamiento de mis datos personales conforme a la Ley 1581 de 2012.
        </label>
        <div class="sm:col-span-2">
          <button type="submit" class="h-14 w-full rounded-xl bg-navy font-bold text-white transition-colors hover:bg-navy-2">Enviar mensaje</button>
        </div>
      </form>

      <div class="flex flex-col gap-4">
        <div class="group overflow-hidden rounded-3xl border border-[#e3ded3]">
          <img src={contacto.fotoOficina} alt="Fachada de la oficina de Agencia Vintage de Seguros" class="h-72 w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" />
        </div>
        <div class="flex flex-col gap-5 rounded-3xl bg-sand p-8">
          <div class="flex flex-col gap-1">
            <span class="flex items-center gap-2 text-[12.5px] font-bold uppercase tracking-[0.12em] text-gold-ink"><Icono name="ubicacion" class="h-4 w-4" />Oficina</span>
            <span class="text-base font-bold text-navy">{contacto.direccion}</span>
            <span class="text-slate">{contacto.ciudad}</span>
          </div>
          <div class="flex flex-col gap-1">
            <span class="flex items-center gap-2 text-[12.5px] font-bold uppercase tracking-[0.12em] text-gold-ink"><Icono name="reloj" class="h-4 w-4" />Horario de atención</span>
            {contacto.horario.map((h) => <span class="text-slate">{h}</span>)}
          </div>
          <div class="flex flex-col gap-1">
            <span class="flex items-center gap-2 text-[12.5px] font-bold uppercase tracking-[0.12em] text-gold-ink"><Icono name="web" class="h-4 w-4" />Sitio web</span>
            <a href={contacto.webUrl} class="text-base font-bold text-navy hover:text-gold-ink">{contacto.web}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- MAPA DE UBICACIÓN -->
  <section class="bg-white px-6 pb-24 lg:px-10">
    <div class="mx-auto flex max-w-7xl flex-col gap-4">
      <div class="flex flex-col items-end justify-between gap-3 sm:flex-row">
        <div class="flex items-center gap-3">
          <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-sand text-gold-ink"><Icono name="ubicacion" class="h-5 w-5" /></span>
          <div class="flex flex-col">
            <span class="text-[15px] font-extrabold text-navy">{contacto.direccion}</span>
            <span class="text-sm text-slate">{contacto.ciudad}</span>
          </div>
        </div>
        <a href={mapaLinkUrl} target="_blank" rel="noopener" class="inline-flex h-11 items-center gap-2 rounded-xl border border-navy px-5 text-sm font-bold text-navy transition-colors hover:bg-navy hover:text-white">Cómo llegar <Icono name="flecha" class="h-4 w-4" /></a>
      </div>
      <div class="overflow-hidden rounded-3xl border border-[#e3ded3]">
        <iframe
          title="Ubicación de Agencia Vintage de Seguros"
          src={mapaEmbedUrl}
          width="100%"
          height="460"
          style="border:0; display:block"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>
</LayoutB>
