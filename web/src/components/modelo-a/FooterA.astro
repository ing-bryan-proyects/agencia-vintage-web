---
import { contacto, telUrl, correoUrl } from "@/data/contacto";

const links = [
  { label: "Inicio", href: "/a" },
  { label: "Quiénes somos", href: "/a/quienes-somos" },
  { label: "Nuestros servicios", href: "/a/servicios" },
  { label: "Contacto", href: "/a/contacto" },
];
const anio = new Date().getFullYear();
---
<footer class="bg-ink font-body text-cream/70">
  <div class="mx-auto max-w-7xl px-6 py-16 lg:px-10">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-[2fr_1fr_1.4fr]">
      <div class="flex flex-col gap-5">
        <img src="/images/logo-claro.png" alt={contacto.nombre} width="240" height="66" class="h-16 w-auto self-start" />
        <p class="max-w-sm text-[14.5px] leading-relaxed">
          Servicio especializado de asesoría y colocación de seguros. Agentes certificados por Fasecolda.
        </p>
      </div>

      <nav aria-label="Sitio" class="flex flex-col gap-3 text-[14.5px]">
        <span class="text-xs font-semibold uppercase tracking-[0.14em] text-gold">Sitio</span>
        {links.map((l) => <a href={l.href} class="text-cream hover:text-gold">{l.label}</a>)}
      </nav>

      <div class="flex flex-col gap-3 text-[14.5px]">
        <span class="text-xs font-semibold uppercase tracking-[0.14em] text-gold">Contacto</span>
        {contacto.telefonos.map((t) => <a href={telUrl} class="text-cream hover:text-gold">{t}</a>)}
        <a href={correoUrl} class="break-all text-cream hover:text-gold">{contacto.correo}</a>
        <a href={contacto.webUrl} class="text-cream hover:text-gold">{contacto.web}</a>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t border-white/10 pt-6 text-[13px] sm:flex-row sm:items-center sm:justify-between">
      <span>© {anio} {contacto.nombre}. Todos los derechos reservados.</span>
      <span class="flex items-center gap-4">
        <a href="/a/contacto" class="hover:text-gold">Política de tratamiento de datos</a>
        <span class="text-cream/30">·</span>
        <span>Desarrollado por <a href="https://bryan.dev" class="font-semibold text-gold hover:text-gold-soft">bryan.dev</a></span>
      </span>
    </div>
  </div>
</footer>
