---
import Abanico from "@/components/Abanico.astro";
import { whatsappUrl } from "@/data/contacto";

interface Props {
  titulo?: string;
  texto?: string;
}
const {
  titulo = "¿Listo para proteger lo que más te importa?",
  texto = "Un asesor te acompaña a elegir y financiar tu póliza.",
} = Astro.props;
---
<section class="bg-cream px-6 py-16 lg:px-10">
  <div class="mx-auto max-w-7xl">
    <div class="relative flex flex-col items-start justify-between gap-8 overflow-hidden rounded-[28px] bg-ink px-8 py-12 md:flex-row md:items-center md:px-16">
      <Abanico class="fan-pattern -bottom-10 -right-10 w-[420px] rotate-0 opacity-20" color="#d9be86" />
      <div class="relative flex flex-col gap-3">
        <h2 class="max-w-xl font-display text-3xl font-bold leading-tight text-white sm:text-4xl">{titulo}</h2>
        <p class="text-lg text-cream/80">{texto}</p>
      </div>
      <div class="relative flex shrink-0 flex-wrap gap-3">
        <a href="/a/contacto" class="inline-flex h-14 items-center rounded-full bg-gold px-8 font-semibold text-ink transition-colors hover:bg-gold-soft">Solicitar asesoría</a>
        <a href={whatsappUrl} class="inline-flex h-14 items-center rounded-full border border-white/25 px-7 font-medium text-white transition-colors hover:bg-white/10">WhatsApp</a>
      </div>
    </div>
  </div>
</section>
