---
import { clientes } from "@/data/clientes";

interface Props {
  /** "a" o "b": ajusta bordes/tipografía al modelo. */
  theme?: "a" | "b";
}
const { theme = "b" } = Astro.props;
const font = theme === "a" ? "font-body" : "font-sans";
---
<ul class:list={["grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6", font]}>
  {clientes.map((c) => (
    <li class="flex h-28 items-center justify-center rounded-2xl border border-black/10 bg-white p-4">
      <img
        src={c.logo}
        alt={c.nombre}
        loading="lazy"
        decoding="async"
        class="max-h-20 w-auto max-w-full object-contain"
      />
    </li>
  ))}
</ul>
