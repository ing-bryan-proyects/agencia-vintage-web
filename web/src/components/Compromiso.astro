---
import Icono from "@/components/Icono.astro";
import PatronVintage from "@/components/PatronVintage.astro";
import { beneficiosBrochure } from "@/data/agencia";

interface Props {
  /** "a" (clásico dorado) o "b" (corporativo moderno). */
  theme?: "a" | "b";
}
const { theme = "a" } = Astro.props;

const esA = theme === "a";
const cfg = {
  bg: esA ? "bg-ink" : "bg-navy",
  heading: esA ? "font-display font-bold" : "font-sans font-extrabold tracking-tight",
  gold: esA ? "text-gold" : "text-gold-soft",
  pillBorder: esA ? "border-gold/50" : "border-gold-2/50",
  bullet: esA ? "text-gold" : "text-gold-2",
  ring: esA ? "border-gold" : "border-gold-2",
  patron: esA ? "#d9be86" : "#c9a45c",
  cuerpo: esA ? "text-cream/80" : "text-[#c8d3e3]",
};
---
<section class:list={["relative overflow-hidden px-6 py-24 lg:px-10", cfg.bg]}>
  <PatronVintage class="pointer-events-none absolute inset-0 h-full w-full" color={cfg.patron} opacity={0.1} />
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-black/10 via-transparent to-black/30"></div>

  <div class="relative mx-auto flex max-w-6xl flex-col items-center gap-14">
    <!-- Lema en cápsula -->
    <div class:list={["rounded-3xl border px-8 py-6 text-center sm:px-12", cfg.pillBorder]}>
      <h2 class:list={["text-3xl leading-tight text-white sm:text-4xl", cfg.heading]}>
        Comprometidos con tu tranquilidad y <span class={cfg.gold}>TU SEGURIDAD.</span>
      </h2>
    </div>

    <div class="grid w-full items-center gap-12 lg:grid-cols-2">
      <!-- Foto circular con aro -->
      <div class="flex justify-center">
        <div class:list={["rounded-full border-2 p-2", cfg.ring]}>
          <div class="aspect-square w-72 overflow-hidden rounded-full bg-navy-2 sm:w-80">
            <img src="/images/fotos/cliente-camion.jpg" alt="Cliente satisfecho de Agencia Vintage" loading="lazy" class="h-full w-full object-cover" />
          </div>
        </div>
      </div>

      <!-- Beneficios -->
      <div class="flex flex-col gap-6">
        <h3 class:list={["text-2xl uppercase tracking-[0.14em]", cfg.heading, cfg.gold]}>Beneficios</h3>
        <ul class="flex flex-col gap-4">
          {beneficiosBrochure.map((b) => (
            <li class:list={["flex items-center gap-3 text-lg", cfg.cuerpo]}>
              <Icono name="check" class:list={["h-5 w-5 shrink-0", cfg.bullet]} />{b}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
