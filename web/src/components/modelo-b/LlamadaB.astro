---
import Abanico from "@/components/Abanico.astro";
---
<section class="bg-white px-6 py-14 lg:px-10">
  <div class="mx-auto max-w-7xl">
    <div class="relative grid items-center gap-8 overflow-hidden rounded-[28px] bg-navy px-8 py-12 sm:px-14 lg:grid-cols-[5fr_7fr]">
      <Abanico class="fan-pattern -bottom-16 left-[-60px] w-[380px] opacity-25" color="#c9a45c" />
      <div class="relative flex flex-col gap-3">
        <span class="text-[13px] font-bold uppercase tracking-[0.12em] text-gold-soft">Te llamamos</span>
        <h2 class="text-3xl font-extrabold leading-tight text-white">Déjanos tu número y un asesor te contacta</h2>
        <p class="text-[15.5px] leading-relaxed text-[#c8d3e3]">Te ayudamos a elegir, cotizar y financiar tu póliza.</p>
      </div>
      <form class="relative grid gap-3 sm:grid-cols-2" method="post" action="#" data-mailto="agenciavintagedeseguros@gmail.com" data-asunto="Solicitud de llamada desde el sitio web">
        <label class="flex flex-col gap-1.5 text-[13px] font-semibold text-[#c8d3e3]">Nombre
          <input type="text" name="nombre" required placeholder="Tu nombre" class="h-12 rounded-xl border-0 bg-white px-4 text-[15px] text-carbon" />
        </label>
        <label class="flex flex-col gap-1.5 text-[13px] font-semibold text-[#c8d3e3]">Celular
          <input type="tel" name="celular" required placeholder="300 000 0000" class="h-12 rounded-xl border-0 bg-white px-4 text-[15px] text-carbon" />
        </label>
        <label class="flex flex-col gap-1.5 text-[13px] font-semibold text-[#c8d3e3]">¿Qué quieres asegurar?
          <select name="tipo" class="h-12 rounded-xl border-0 bg-white px-3.5 text-[15px] text-carbon">
            <option>Mi vehículo</option>
            <option>Mi empresa</option>
            <option>Mi vida y mi familia</option>
            <option>Mi carga o mercancía</option>
            <option>Un contrato (cumplimiento)</option>
          </select>
        </label>
        <div class="flex items-end">
          <button type="submit" class="h-12 w-full rounded-xl bg-gold-2 font-extrabold text-navy transition-colors hover:bg-gold-soft">Quiero que me llamen</button>
        </div>
      </form>
    </div>
  </div>
</section>
